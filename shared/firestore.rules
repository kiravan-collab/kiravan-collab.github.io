rules_version = '2';

// ============================================================
//  미니게임 서랍 - Firestore 보안 규칙
//  Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣고 "게시"
//
//  막아주는 것
//   - 남의 기록 덮어쓰기 (문서 ID = 익명 로그인 uid 로 고정)
//   - 기록 삭제 (앱에서는 삭제 불가, 콘솔에서만 가능)
//   - 말도 안 되는 점수 (게임별 상한 초과)
//   - 점수 낮추기 / 되돌리기 (기존 기록보다 높을 때만 갱신)
//   - 정의되지 않은 필드 주입
//   - 그 외 모든 컬렉션 접근
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 게임별 랭킹 점수 상한 (leaderboard.js 의 computePoints 와 같은 값)
    function maxPoints(game) {
      return game == 'bullet-storm' ? 3000
           : game == 'slide-puzzle' ? 2500
           : game == 'pipe-connect' ? 2500
           : 2000;
    }

    function isOwner(playerId) {
      return request.auth != null && request.auth.uid == playerId;
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 20;
    }

    // 서버 시각으로만 기록되게 강제 (임의 시각 위조 차단)
    function serverTime(d) {
      return d.updatedAt == request.time;
    }

    function validScore(game, d) {
      return d.keys().hasOnly(['name','moves','timeSec','points','updatedAt'])
          && d.keys().hasAll(['name','points','updatedAt'])
          && validName(d.name)
          && d.points is number && d.points >= 0 && d.points <= maxPoints(game)
          && (!('moves' in d)   || (d.moves   is number && d.moves   >= 0 && d.moves   <= 100000))
          && (!('timeSec' in d) || (d.timeSec is number && d.timeSec >= 0 && d.timeSec <= 86400))
          && serverTime(d);
    }

    match /scores_{game}/{playerId} {
      allow read: if true;
      allow create: if isOwner(playerId) && validScore(game, request.resource.data);
      // 기존 기록보다 높을 때만 갱신 — 점수 되돌리기/깎기 차단
      allow update: if isOwner(playerId)
                    && validScore(game, request.resource.data)
                    && request.resource.data.points > resource.data.points;
      allow delete: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isOwner(playerId)
                    && request.resource.data.keys().hasOnly(['name','perGame','totalPoints','updatedAt'])
                    && request.resource.data.keys().hasAll(['name','perGame','totalPoints','updatedAt'])
                    && validName(request.resource.data.name)
                    && request.resource.data.perGame is map
                    && request.resource.data.perGame.size() <= 20
                    && request.resource.data.totalPoints is number
                    && request.resource.data.totalPoints >= 0
                    && request.resource.data.totalPoints <= 20000
                    && serverTime(request.resource.data);
      allow delete: if false;
    }

    // 그 외 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
