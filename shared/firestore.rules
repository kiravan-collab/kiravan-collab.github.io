rules_version = '2';

// ============================================================
//  미니게임 서랍 - Firestore 보안 규칙
//  Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣고 "게시"
//
//  적용 전에 Authentication > 로그인 방법 > '익명' 을 먼저 사용 설정하세요.
//
//  막아주는 것
//   - 남의 기록 덮어쓰기 (문서 ID = 익명 로그인 uid 로 고정)
//   - 기록 삭제 (앱에서는 삭제 불가, 콘솔에서만 가능)
//   - 게임별 상한을 넘는 점수
//   - 점수 낮추기 / 되돌리기 (기존 기록보다 높을 때만 갱신)
//   - 정의되지 않은 필드 주입
//   - 그 외 모든 컬렉션 접근 (전체 합산 랭킹용 players 컬렉션도 이제 차단)
//
//  주의: 아래 점수 상한은 shared/leaderboard.js 의 MAX_POINTS 와 같아야 합니다.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(playerId) {
      return request.auth != null && request.auth.uid == playerId;
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 20;
    }

    // 서버 시각으로만 기록되게 강제 (임의 시각 위조 차단)
    function serverTime(d) {
      return d.updatedAt == request.time;
    }

    function validScore(d, cap) {
      return d.keys().hasOnly(['name', 'moves', 'timeSec', 'points', 'updatedAt'])
          && d.keys().hasAll(['name', 'points', 'updatedAt'])
          && validName(d.name)
          && d.points is number && d.points >= 0 && d.points <= cap
          && (!('moves' in d) || (d.moves is number && d.moves >= 0 && d.moves <= 100000))
          && (!('timeSec' in d) || (d.timeSec is number && d.timeSec >= 0 && d.timeSec <= 86400))
          && serverTime(d);
    }

    function canCreateScore(playerId, cap) {
      return isOwner(playerId) && validScore(request.resource.data, cap);
    }

    // 기존 기록보다 높을 때만 갱신 — 점수 되돌리기/깎기 차단
    function canUpdateScore(playerId, cap) {
      return isOwner(playerId)
          && validScore(request.resource.data, cap)
          && request.resource.data.points > resource.data.points;
    }

    // ---- 게임별 랭킹 --------------------------------------
    //  경로 중간에는 와일드카드를 쓸 수 없어 컬렉션마다 따로 적습니다.

    match /scores_bullet-storm/{playerId} {
      allow read: if true;
      allow create: if canCreateScore(playerId, 2000);
      allow update: if canUpdateScore(playerId, 2000);
      allow delete: if false;
    }

    match /scores_merge-2048/{playerId} {
      allow read: if true;
      allow create: if canCreateScore(playerId, 2000);
      allow update: if canUpdateScore(playerId, 2000);
      allow delete: if false;
    }

    match /scores_slide-puzzle/{playerId} {
      allow read: if true;
      allow create: if canCreateScore(playerId, 2000);
      allow update: if canUpdateScore(playerId, 2000);
      allow delete: if false;
    }

    match /scores_pipe-connect/{playerId} {
      allow read: if true;
      allow create: if canCreateScore(playerId, 2000);
      allow update: if canUpdateScore(playerId, 2000);
      allow delete: if false;
    }

    match /scores_color-flood/{playerId} {
      allow read: if true;
      allow create: if canCreateScore(playerId, 2000);
      allow update: if canUpdateScore(playerId, 2000);
      allow delete: if false;
    }

    match /scores_lights-out/{playerId} {
      allow read: if true;
      allow create: if canCreateScore(playerId, 2000);
      allow update: if canUpdateScore(playerId, 2000);
      allow delete: if false;
    }

    // ---- 그 외 전부 차단 -----------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
